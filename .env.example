# Environment variables template for PathAI / Shiksha
ENV=development
APP_NAME="PathAI (Shiksha)"

# Google / Gemini AI API Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas / Local
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_CORE_DB=pathai_core
MONGODB_CHAT_DB=pathai_chat
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=8000

# Chroma Cloud
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here
CHROMA_PUBLIC_COLLECTION=shiksha_public_knowledge

REDIS_URL=redis://localhost:6379/0

IS_READY=true
